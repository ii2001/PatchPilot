# Export these values yourself; PatchPilot does not automatically load this file.
# Real GitHub API token: selected repositories only, Actions read / Contents write / Pull requests write.
GITHUB_TOKEN=
# All classification, diagnosis and patch generation use OpenAI. This is a lightweight test profile.
OPENAI_API_KEY=
PATCHPILOT_OPENAI_MODEL=gpt-6-luna
# none disables extra reasoning for tests; clear this variable for models without reasoning support.
PATCHPILOT_REASONING_EFFORT=none
# Temperature is sent only when reasoning effort is unset or none.
PATCHPILOT_TEMPERATURE=0
PATCHPILOT_LLM_TIMEOUT=60
# Comma-separated repositories. Required for real repair and webhook; empty denies all.
PATCHPILOT_ALLOWED_REPOS=
# Durable jobs, LLM cache and LangGraph checkpoints; never commit this directory.
PATCHPILOT_DATA_DIR=.patchpilot
# Immutable Docker image ID (sha256:...) or registry/image@sha256:...; mutable tags are rejected.
PATCHPILOT_SANDBOX_IMAGE=
# Total timeout per sandbox run, including targeted and full pytest; range 1..600 seconds.
PATCHPILOT_TEST_TIMEOUT=120
# Optional comma-separated repository-relative test paths/node IDs; empty uses full suite in both stages.
PATCHPILOT_TEST_TARGETS=
# Optional required variable names only. Secret values are NEVER forwarded; missing values mean manual action.
PATCHPILOT_REQUIRED_ENV=
# Required only for optional webhook. Use a strong random secret matching GitHub webhook configuration.
PATCHPILOT_WEBHOOK_SECRET=
# Explicit test opt-ins. Defaults are off; live tests also require credentials.
PATCHPILOT_RUN_DOCKER_TESTS=0
PATCHPILOT_RUN_LIVE_TESTS=0
# Only used by opt-in GitHub read smoke test:
PATCHPILOT_LIVE_REPO=
PATCHPILOT_LIVE_RUN_ID=
